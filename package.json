{
  "name": "nhl94-build",
  "version": "1.0.0",
  "description": "Build scripts for NHL 94 Genesis",
  "scripts": {
    "extractassets": "node extractAssets94.js lst/nhl94.bin",
    "asm": "build94.bat",
    "fixopcodes": "node fixopcodes.js \"output\\nhl94 .lst\" output\\nhl94.bin",
    "build:retail": "set rev=0&& set checksum=1&& npm run asm && npm run fixopcodes",
    "build:seg": "echo segment not started",
    "verify:seg": "echo segment not started"
  },
  "devDependencies": {
    "crc-32": "^1.2.2"
  },
